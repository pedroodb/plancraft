{
  "name": "@plancraft/furniture",
  "version": "0.1.0",
  "description": "Furniture element system with SVG packs for Plancraft floor plans",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedroodb/plancraft.git",
    "directory": "packages/furniture"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "elements"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
