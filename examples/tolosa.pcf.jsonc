{
  // Tolosa — Argentine-style ground floor ("Planta Baja")
  // 11 rooms: Cochera, Estar, Toilette, Pasillo, Paso, Escalera,
  //           Baño, Comedor, Living, Cocina, Dormitorio

  "placements": [

    // ─── Cochera (L-shaped garage, inner x=100-5690, y=100-4900) ────
    // Car parked in the main rectangular section
    { "element": "default/car", "position": {"x": 2400, "y": 2300}, "room": "Cochera" },

    // ─── Estar (small living, inner x=4880-7490, y=100-3120) ────────
    // Sofa against south wall
    { "element": "default/sofa", "position": {"x": 6185, "y": 600}, "room": "Estar" },
    // Coffee table in front
    { "element": "default/coffee_table", "position": {"x": 6185, "y": 1300}, "room": "Estar" },
    // TV console against north wall
    { "element": "default/tv_console", "position": {"x": 6185, "y": 2900}, "room": "Estar" },

    // ─── Toilette (small bathroom, inner x=5890-7490, y=3320-4900) ──
    { "element": "default/toilet", "position": {"x": 6400, "y": 4500}, "room": "Toilette" },
    { "element": "default/sink", "position": {"x": 7100, "y": 4600}, "room": "Toilette" },

    // ─── Escalera (staircase, inner x=3875-4945, y=5775-7525) ───────
    // Staircase scaled to fit the narrow room
    { "element": "default/staircase", "position": {"x": 4410, "y": 6650}, "scaleWidth": 100, "scaleDepth": 68, "room": "Escalera" },

    // ─── Baño (bathroom, inner x=5120-7490, y=5100-7500) ────────────
    { "element": "default/toilet", "position": {"x": 5500, "y": 5600}, "room": "Baño" },
    { "element": "default/sink", "position": {"x": 6300, "y": 5400}, "room": "Baño" },
    { "element": "default/bathtub", "position": {"x": 6640, "y": 6600}, "rotation": 90, "room": "Baño" },

    // ─── Comedor (dining room, inner x=100-3700, y=7700-11550) ──────
    // Dining table centered
    { "element": "default/table", "position": {"x": 1900, "y": 9500}, "room": "Comedor" },
    // Four chairs around the table
    { "element": "default/chair", "position": {"x": 1200, "y": 9500}, "room": "Comedor" },
    { "element": "default/chair", "position": {"x": 2600, "y": 9500}, "room": "Comedor" },
    { "element": "default/chair", "position": {"x": 1900, "y": 8900}, "room": "Comedor" },
    { "element": "default/chair", "position": {"x": 1900, "y": 10100}, "room": "Comedor" },
    // Bookshelf against west wall
    { "element": "default/bookshelf", "position": {"x": 400, "y": 10800}, "rotation": 90, "room": "Comedor" },

    // ─── Living (inner x=3900-7490, y=7700-11550) ───────────────────
    // Sofa against south wall
    { "element": "default/sofa", "position": {"x": 5700, "y": 8400}, "room": "Living" },
    // Coffee table in front
    { "element": "default/coffee_table", "position": {"x": 5700, "y": 9100}, "room": "Living" },
    // Bookshelf against east wall (rotated 90°)
    { "element": "default/bookshelf", "position": {"x": 7200, "y": 10500}, "rotation": 90, "room": "Living" },
    // Floor lamp in NW corner
    { "element": "default/floor_lamp", "position": {"x": 4200, "y": 11200}, "room": "Living" },

    // ─── Cocina (kitchen, inner x=100-3700, y=11750-14150) ──────────
