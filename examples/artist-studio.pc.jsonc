{
  "name": "Artist Studio",
  "scale": 100,
  "unit": "mm",

  "floors": [
    {
      "name": "Ground Floor",
      "rooms": [
        // ── Studio (pentagonal — diagonal SW wall) ──────────────────────
        // The southwest corner is cut at 45° by an oblique (diagonal) wall,
        // creating a pentagonal room. This demonstrates non-axis-aligned
        // wall coordinates. A window is placed on the diagonal wall.
        {
          "name": "Studio",
          "walls": [
            { "direction": "south",       "from": {"x": 2000, "y": 0},    "to": {"x": 8000, "y": 0},    "thickness": 200 },
            { "direction": "east",        "from": {"x": 8000, "y": 0},    "to": {"x": 8000, "y": 5000}, "thickness": 200 },
            { "direction": "north right", "from": {"x": 8000, "y": 5000}, "to": {"x": 2500, "y": 5000}, "thickness": 150 },
            { "direction": "north left",  "from": {"x": 2500, "y": 5000}, "to": {"x": 0, "y": 5000},    "thickness": 150 },
            { "direction": "west",        "from": {"x": 0, "y": 5000},    "to": {"x": 0, "y": 2000},    "thickness": 200 },
            // Oblique wall — from and to are NOT axis-aligned (45° diagonal)
            { "direction": "diagonal",    "from": {"x": 0, "y": 2000},    "to": {"x": 2000, "y": 0},    "thickness": 200 }
          ],
          "doors": [
            // Main entrance
            { "wall": "south", "offset": 1500, "width": 900, "swing": "left" },
            // Door to Gallery
            { "wall": "north right", "offset": 2000, "width": 900, "swing": "right" },
            // Door to Washroom
            { "wall": "north left", "offset": 800, "width": 700, "swing": "left" }
          ],
          "windows": [
            // Floor-to-ceiling studio window on east wall (maximum light)
            { "wall": "east", "offset": 1500, "width": 2000, "height": 2200, "sill": 200 },
            // Window on the oblique wall — proves elements work on diagonal walls
            { "wall": "diagonal", "offset": 500, "width": 1200, "height": 1400, "sill": 900 }
          ]
        },

        // ── Gallery (semicircular east bay, bulge: -1.0) ────────────────
        // The east wall forms a perfect semicircle (bulge: -1.0), creating
        // a dramatic curved display space. Both a window and an archway
        // opening are placed on the curved wall, demonstrating that all
        // wall element types work on curved geometry.
        {
          "name": "Gallery",
          "walls": [
            { "direction": "south", "from": {"x": 2500, "y": 5000}, "to": {"x": 8000, "y": 5000}, "thickness": 150 },
            // Perfect semicircular bay — bulge -1.0 means the curve is a full semicircle
            { "direction": "east",  "from": {"x": 8000, "y": 5000}, "to": {"x": 8000, "y": 8000}, "thickness": 200, "bulge": -1.0 },
            { "direction": "north", "from": {"x": 8000, "y": 8000}, "to": {"x": 2500, "y": 8000}, "thickness": 200 },
            { "direction": "west",  "from": {"x": 2500, "y": 8000}, "to": {"x": 2500, "y": 5000}, "thickness": 150 }
          ],
          "windows": [
            // Tall window on the semicircular bay wall
            { "wall": "east", "offset": 200, "width": 1000, "height": 2200, "sill": 200 },
            // Standard window on north wall
            { "wall": "north", "offset": 1500, "width": 1500, "height": 1400, "sill": 900 }
          ],
          "openings": [
            // Archway on the curved wall — terrace access through the semicircle
            { "wall": "east", "offset": 1800, "width": 1000 }
          ]
        },

        // ── Washroom (compact, 2.5m × 3m) ──────────────────────────────
        {
          "name": "Washroom",
          "walls": [
            { "direction": "south", "from": {"x": 0, "y": 5000},    "to": {"x": 2500, "y": 5000}, "thickness": 150 },
            { "direction": "east",  "from": {"x": 2500, "y": 5000}, "to": {"x": 2500, "y": 8000}, "thickness": 150 },
            { "direction": "north", "from": {"x": 2500, "y": 8000}, "to": {"x": 0, "y": 8000}, "thickness": 200 },
            { "direction": "west",  "from": {"x": 0, "y": 8000},    "to": {"x": 0, "y": 5000}, "thickness": 200 }
          ],
          "windows": [
            // Small frosted window (high sill for privacy)
            { "wall": "north", "offset": 500, "width": 800, "height": 1000, "sill": 1200 }
          ]
        }
      ]
    }
  ]
}
