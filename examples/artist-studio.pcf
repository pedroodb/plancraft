{
  // ── Custom Element ────────────────────────────────────────────────────
  // An artist's easel — not in the default package, defined inline.
  "elements": {
    "easel": {
      "name": "Artist Easel",
      "tags": ["studio", "furniture", "custom"],
      "defaultWidth": 600,
      "defaultDepth": 500,
      "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 600 500\"><rect x=\"150\" y=\"50\" width=\"300\" height=\"400\" fill=\"#f5f5f5\" stroke=\"black\" stroke-width=\"5\" rx=\"5\"/><line x1=\"100\" y1=\"480\" x2=\"300\" y2=\"50\" stroke=\"black\" stroke-width=\"8\"/><line x1=\"500\" y1=\"480\" x2=\"300\" y2=\"50\" stroke=\"black\" stroke-width=\"8\"/><line x1=\"50\" y1=\"380\" x2=\"550\" y2=\"380\" stroke=\"black\" stroke-width=\"6\"/></svg>",
      "source": "generated"
    }
  },

  // ── Placements ────────────────────────────────────────────────────────
  "placements": [

    // ─── Studio (2000,0)-(8000,5000) with diagonal SW corner ─────────
    // Work area near the large east window
    { "element": "default/executive_desk", "position": {"x": 6500, "y": 1500}, "room": "Studio" },
    { "element": "default/office_chair",   "position": {"x": 5800, "y": 1500}, "room": "Studio" },
    { "element": "default/filing_cabinet", "position": {"x": 7500, "y": 1500}, "room": "Studio" },
    // Whiteboard for sketching ideas — against the north wall
    { "element": "default/whiteboard",     "position": {"x": 5000, "y": 4700}, "room": "Studio" },
    // Seating area in the center
    { "element": "default/sofa",           "position": {"x": 4500, "y": 3800}, "room": "Studio" },
    { "element": "default/coffee_table",   "position": {"x": 4500, "y": 3000}, "room": "Studio" },
    // Storage along the west wall
    { "element": "default/bookshelf",      "position": {"x": 500, "y": 3800},  "room": "Studio" },
    // Lighting near the diagonal wall — positioned safely inside the pentagon
    { "element": "default/floor_lamp",     "position": {"x": 2500, "y": 1500}, "room": "Studio" },

    // ─── Gallery (2500,5000)-(8000+semicircle,8000) ──────────────────
    // Round display table in the semicircular bay
    { "element": "default/round_table",    "position": {"x": 7000, "y": 6500}, "room": "Gallery" },
    { "element": "default/chair",          "position": {"x": 6200, "y": 6500}, "room": "Gallery" },
    { "element": "default/chair",          "position": {"x": 7000, "y": 7200}, "room": "Gallery" },
    // Custom easel for displaying artwork
    { "element": "easel",                  "position": {"x": 4000, "y": 6200}, "room": "Gallery" },
    { "element": "default/floor_lamp",     "position": {"x": 3200, "y": 7200}, "room": "Gallery" },

    // ─── Washroom (0,5000)-(2500,8000) ───────────────────────────────
    { "element": "default/toilet",         "position": {"x": 800, "y": 6500},  "room": "Washroom" },
    { "element": "default/sink",           "position": {"x": 1800, "y": 5500}, "room": "Washroom" }
  ]
}
