{
  "name": "Curved Villa",
  "scale": 100,
  "unit": "mm",

  "floors": [
    {
      "name": "Ground Floor",
      "rooms": [
        // ── Living Room (bottom, 10m × 4m) ──────────────────────────────
        // South wall has a subtle outward curve (bulge: -0.1) creating a
        // bay window effect across the entire facade. Windows and a
        // sliding glass door are placed on the curved wall.
        {
          "name": "Living Room",
          "walls": [
            { "direction": "south", "from": {"x": 0, "y": 0}, "to": {"x": 10000, "y": 0}, "thickness": 200, "bulge": -0.1 },
            { "direction": "east",  "from": {"x": 10000, "y": 0}, "to": {"x": 10000, "y": 4000}, "thickness": 200 },
            { "direction": "north", "from": {"x": 10000, "y": 4000}, "to": {"x": 0, "y": 4000}, "thickness": 150 },
            { "direction": "west",  "from": {"x": 0, "y": 4000}, "to": {"x": 0, "y": 0}, "thickness": 200 }
          ],
          "doors": [
            // Door to Hallway
            { "wall": "north", "offset": 4000, "width": 900, "swing": "right" },
            // Sliding glass door on the curved south facade (garden access)
            { "wall": "south", "offset": 3500, "width": 2000, "swing": "sliding" }
          ],
          "windows": [
            // Windows flanking the sliding door on the curved wall
            { "wall": "south", "offset": 1000, "width": 1500, "height": 1400, "sill": 900 },
            { "wall": "south", "offset": 7000, "width": 1500, "height": 1400, "sill": 900 },
            // Side window
            { "wall": "west", "offset": 1000, "width": 1200, "height": 1400, "sill": 900 }
          ]
        },

        // ── Hallway (middle strip, 10m × 1.2m) ─────────────────────────
        // Connects the Living Room to the upper rooms. North wall is
        // split into segments for shared wall references with each room.
        {
          "name": "Hallway",
          "sharedWalls": [
            { "direction": "south", "sourceRoom": "Living Room", "sourceWall": "north" }
          ],
          "walls": [
            { "direction": "east",        "from": {"x": 10000, "y": 4000}, "to": {"x": 10000, "y": 5200}, "thickness": 200 },
            { "direction": "north right", "from": {"x": 10000, "y": 5200}, "to": {"x": 6500, "y": 5200},  "thickness": 150 },
            { "direction": "north mid",   "from": {"x": 6500, "y": 5200},  "to": {"x": 4000, "y": 5200},  "thickness": 150 },
            { "direction": "north left",  "from": {"x": 4000, "y": 5200},  "to": {"x": 0, "y": 5200},     "thickness": 150 },
            { "direction": "west",        "from": {"x": 0, "y": 5200},     "to": {"x": 0, "y": 4000},     "thickness": 200 }
          ],
          "doors": [
            // Front entrance
            { "wall": "west", "offset": 200, "width": 900, "swing": "left" },
            // Door to Bedroom
            { "wall": "north left", "offset": 1200, "width": 800, "swing": "right" },
            // Door to Bathroom
            { "wall": "north mid", "offset": 700, "width": 700, "swing": "left" }
          ],
          "openings": [
            // Wide archway to Sunroom — open transition
            { "wall": "north right", "offset": 800, "width": 1500 }
          ]
        },

        // ── Bedroom (top-left, 4m × 2.8m) ──────────────────────────────
        {
          "name": "Bedroom",
          "sharedWalls": [
            { "direction": "south", "sourceRoom": "Hallway", "sourceWall": "north left" }
          ],
          "walls": [
            { "direction": "east",  "from": {"x": 4000, "y": 5200}, "to": {"x": 4000, "y": 8000}, "thickness": 150 },
            { "direction": "north", "from": {"x": 4000, "y": 8000}, "to": {"x": 0, "y": 8000},    "thickness": 200 },
            { "direction": "west",  "from": {"x": 0, "y": 8000},    "to": {"x": 0, "y": 5200},    "thickness": 200 }
          ],
          "windows": [
            { "wall": "north", "offset": 1000, "width": 1500, "height": 1400, "sill": 900 }
          ]
        },

        // ── Bathroom (top-center, 2.5m × 2.8m) ─────────────────────────
        {
          "name": "Bathroom",
          "sharedWalls": [
            { "direction": "south", "sourceRoom": "Hallway", "sourceWall": "north mid" },
            { "direction": "west",  "sourceRoom": "Bedroom", "sourceWall": "east" }
          ],
          "walls": [
            { "direction": "east",  "from": {"x": 6500, "y": 5200}, "to": {"x": 6500, "y": 8000}, "thickness": 150 },
            { "direction": "north", "from": {"x": 6500, "y": 8000}, "to": {"x": 4000, "y": 8000}, "thickness": 200 }
          ],
          "windows": [
            // Small high window for privacy
            { "wall": "north", "offset": 500, "width": 800, "height": 1000, "sill": 1200 }
          ]
        },

        // ── Sunroom (top-right, 3.5m × 2.8m) ───────────────────────────
        // East wall has a pronounced outward curve (bulge: -0.3) creating
        // a conservatory bay effect. Large windows on the curved wall
        // flood the room with natural light.
        {
          "name": "Sunroom",
          "sharedWalls": [
            { "direction": "south", "sourceRoom": "Hallway", "sourceWall": "north right" },
            { "direction": "west",  "sourceRoom": "Bathroom", "sourceWall": "east" }
          ],
          "walls": [
            { "direction": "east",  "from": {"x": 10000, "y": 5200}, "to": {"x": 10000, "y": 8000}, "thickness": 200, "bulge": -0.3 },
            { "direction": "north", "from": {"x": 10000, "y": 8000}, "to": {"x": 6500, "y": 8000},  "thickness": 200 }
          ],
          "windows": [
            // Tall window on the curved east wall
            { "wall": "east", "offset": 500, "width": 1500, "height": 1800, "sill": 400 },
            // North-facing window
            { "wall": "north", "offset": 500, "width": 1200, "height": 1400, "sill": 900 }
          ]
        }
      ]
    }
  ]
}
